{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // Without this reference, @rhizom/core resolves through its build output: the type-aware
  // lint of a fresh checkout would then run before anything has been compiled.
  "references": [{ "path": "../../packages/core/tsconfig.build.json" }]
}
