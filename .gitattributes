# Normalize line endings so the repo behaves identically on Windows, macOS and Linux.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Example vault: test data, kept byte-for-byte (one note is CRLF, one has a BOM)
examples/vault/** -text
